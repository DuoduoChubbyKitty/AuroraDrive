classDiagram
    %% ── 档案标注（2026-09-19 核对，基线 7b7d2db）────────────────────────
    %% 旧「感知层」设计（ROIFrame / ROIKind / PerceptionConfig / LaneDetecting /
    %% MiniMapReading / SpeedOCRReading / SignDetecting / SelfCarFiltering 协议，
    %% LaneLine / LaneDetection / SpeedReading / SignReading / SignKind / TurnHint /
    %% FilteredObstacles / FusedDriveState / SensorFusion / SpeedPlanner /
    %% FusionController / RuleLaneController / VisionLaneDetector / MiniMapReader /
    %% SignDetector / SelfCarFilter）已不在 Sources/ 中，本图按现码替换为
    %% YOLO+E2E+规则+三档降级架构（四档中的 recover 已删）。
    %% CaptureEngine.onFrame 签名已改为 (NSImage, CGImage)。

    class DriveState {
        +tick() void
        +startDriving() void
        +stopDriving() void
        +runNetworkLocateStep() void
    }

    class CaptureEngine {
        +onFrame: ((NSImage, CGImage)->Void)?
        +onYoloFrame: ((CVPixelBuffer)->Void)?
        +onUpscaleFrame: ((CVPixelBuffer)->Void)?
        +onNativeFrame: ((CVPixelBuffer)->Void)?
        +captureFPS: Double
        +speedROINorm: CGRect
        +start() void
        +stop() void
    }

    class InferenceEngine {
        +init(modelFileName: String = "m9_mono")
        +infer(image:speedKmh:speedLimitKmh:) void
        +loadIfNeeded() void
    }

    class YoloEngine {
        +detections: [Detection]
        +infer(image: CGImage) void
        +inferFast(pixelBuffer: CVPixelBuffer) void
        +confidenceThreshold: Double
    }

    class Detection {
        +x: Double
        +y: Double
        +width: Double
        +height: Double
        +label: Label
        +confidence: Double
    }

    class ConfidenceEstimator {
        +update(command:image:isLive:) void
        +confidence: Double
    }

    class RuleController {
        +decide(detections: [Detection]) ControlCommand
        +fuse(detections: [Detection], e2e: ControlCommand) ControlCommand
    }

    class EscapeController {
        +enter() void
        +update(dt: Double, speedKmh: Double) (ControlCommand, Bool)
    }

    class ControlCommand {
        +steer: Double
        +throttle: Double
        +brake: Double
        +confidence: Double
        +idle: ControlCommand
    }

    class DegradeStateMachine {
        +update(m9Live:assistLive:health:warmingUp:speedKmh:dt:speedValid:sportMode:forceRule:) DriveMode
    }

    class DriveMode {
        <<enum>>
        e2e
        yolo
        rule
    }
    %% 2026-10-07 订正：.recover（脱困档）已于 2026-09-30 整体删除，
    %% 降级梯子现为三档 e2e → yolo → rule（DegradeStateMachine.swift:5-9）

    class ControlEngine {
        +press(action:duration:) void
        +hold(action: Action) void
        +release(action: Action) void
        +refreshHeldKeys() void
        +releaseAll() void
    }

    class KeyboardMonitor {
        +start() void
        +stop() void
        +clearAll() void
    }

    class RecordEngine {
        +start(perspective: String) void
        +stop() void
        +glyphMode: Bool
    }

    class SpeedOCRReader {
        +infer(nativePixelBuffer: CVPixelBuffer) void
        +speedKmh: Double
        +confidence: Double
        +activeEngine: SpeedOCREngine
    }

    class CoordinateCapture {
        +start() Bool
        +read(maxAge: Double) Pose?
        +processPacket(header:packet:) void
    }

    class UE5Decoder {
        +decode(payload:timestamp:flow:) Pose?
    }

    class VisualLocator {
        +locate(template:tw:th:scoreThreshold:) LocateResult
    }

    class MinimapTileCache {
        +tiles: [CGImage?]
    }

    class MinimapLocatorView {
        +blockIndex(state:) Int
    }

    class NetworkLocator {
        <<dead code, compiles, never runs>>
        +DualModeLocator
        +MaaNTESocketClient
        +UE5PacketDecoder
    }

    class EngineClient {
        +shared: EngineClient
        +isActive: Bool
        +sendCommand(_ cmd: String) void
    }

    DriveState --> CaptureEngine
    DriveState --> InferenceEngine
    DriveState --> YoloEngine
    DriveState --> ConfidenceEstimator
    DriveState --> RuleController
    DriveState --> EscapeController
    DriveState --> DegradeStateMachine
    DriveState --> ControlEngine
    DriveState --> KeyboardMonitor
    DriveState --> RecordEngine
    DriveState --> SpeedOCRReader
    DriveState --> CoordinateCapture
    DriveState --> EngineClient
    YoloEngine ..> Detection : 产出/读
    RuleController ..> Detection : 读
    RuleController ..> ControlCommand : 产出
    EscapeController ..> ControlCommand : 产出
    DegradeStateMachine ..> DriveMode : 产出
    DegradeStateMachine ..> ConfidenceEstimator : health 输入
    InferenceEngine ..> ControlCommand : steer/throttle/brake
    ControlEngine ..> ControlCommand : 按键映射执行
    CoordinateCapture --> UE5Decoder
    %% 注：MinimapTileCache（FloatingMinimap 用）与 MinimapLocatorView 两套小地图互不引用；
    %% VisualLocator 的 NCC 引擎休眠（唯一调用者是自身 runSelfTest）
