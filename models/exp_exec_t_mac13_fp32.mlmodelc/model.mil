            tensor<fp32, []> _inversed_1268_y_0 = const()[name = tensor<string, []>("_inversed_1268_y_0"), val = tensor<fp32, []>(0x1.111112p-5)];
            tensor<fp32, [1, 1]> _inversed_1268 = mul(x = s_1, y = _inversed_1268_y_0)[name = tensor<string, []>("_inversed_1268")];
            tensor<fp32, [1, 1]> speed_col = tanh(x = _inversed_1268)[name = tensor<string, []>("speed_col")];
            tensor<bool, []> x_interleave_0 = const()[name = tensor<string, []>("x_interleave_0"), val = tensor<bool, []>(false)];
            tensor<fp32, [1, 769]> x = concat(axis = var_22, interleave = x_interleave_0, values = (input_311, det_feat, det_feat, speed_col))[name = tensor<string, []>("x")];
            tensor<fp32, [1, 128]> input_349 = linear(bias = model_temporal_encoder_in_norm_bias, weight = model_risk_head_fc1_weight, x = x)[name = tensor<string, []>("linear_167")];
            tensor<fp32, [1, 128]> input_351 = relu(x = input_349)[name = tensor<string, []>("input_351")];
            tensor<fp32, [1, 128]> input_355 = linear(bias = model_temporal_encoder_in_norm_bias, weight = model_risk_head_fc2_weight, x = input_351)[name = tensor<string, []>("linear_168")];
            tensor<fp32, [1, 128]> input = relu(x = input_355)[name = tensor<string, []>("input")];
            tensor<fp32, [1, 1]> var_1283 = linear(bias = model_risk_head_confidence_head_bias, weight = model_risk_head_confidence_head_weight, x = input)[name = tensor<string, []>("linear_169")];
            tensor<fp32, [1, 1]> var_1284 = sigmoid(x = var_1283)[name = tensor<string, []>("op_1284")];
            tensor<int32, [1]> v_1_axes_0 = const()[name = tensor<string, []>("v_1_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp32, [1]> v_1 = squeeze(axes = v_1_axes_0, x = var_1284)[name = tensor<string, []>("v_1")];
            tensor<fp32, [1, 1]> var_1288 = linear(bias = model_risk_head_risk_head_bias, weight = model_risk_head_risk_head_weight, x = input)[name = tensor<string, []>("linear_170")];
            tensor<fp32, [1, 1]> var_1289 = sigmoid(x = var_1288)[name = tensor<string, []>("op_1289")];
            tensor<int32, [1]> v_3_axes_0 = const()[name = tensor<string, []>("v_3_axes_0"), val = tensor<int32, [1]>([-1])];
            tensor<fp32, [1]> v_3 = squeeze(axes = v_3_axes_0, x = var_1289)[name = tensor<string, []>("v_3")];
            tensor<int32, [2]> var_1303 = const()[name = tensor<string, []>("op_1303"), val = tensor<int32, [2]>([-1, 1])];
            tensor<fp32, [1, 1]> confidence = reshape(shape = var_1303, x = v_1)[name = tensor<string, []>("op_1304")];
            tensor<int32, [2]> var_1307 = const()[name = tensor<string, []>("op_1307"), val = tensor<int32, [2]>([-1, 1])];
            tensor<fp32, [1, 1]> risk = reshape(shape = var_1307, x = v_3)[name = tensor<string, []>("op_1308")];
            tensor<int32, [2]> var_1311 = const()[name = tensor<string, []>("op_1311"), val = tensor<int32, [2]>([-1, 1])];
            tensor<fp32, [1, 1]> car_heading = reshape(shape = var_1311, x = v)[name = tensor<string, []>("op_1312")];
        } -> (steer, throttle, brake, confidence, risk, car_heading);
}