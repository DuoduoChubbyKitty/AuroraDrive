            tensor<fp32, [1, 1]> steer = cast(dtype = var_34_cast_fp16_to_fp32_dtype_0, x = var_34_cast_fp16)[name = string("cast_15")];
            tensor<fp32, [1, 20]> det_mask_tmp = identity(x = det_mask)[name = string("det_mask_tmp")];
        } -> (steer, throttle, brake, confidence, risk, car_heading);
}